# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=atrpap.com.br,www.atrpap.com.br

# ── Banco de Dados — MySQL (Hostinger Business) ───────────────────────────────
# Crie o banco em: hPanel → Bancos de Dados → Bancos de Dados MySQL
# O host é sempre "localhost" no plano Business (mesmo servidor)
DB_ENGINE=django.db.backends.mysql
DB_NAME=u123456789_atrpap
DB_USER=u123456789_atrpap
DB_PASSWORD=SuaSenhaMySQLAqui
DB_HOST=localhost
DB_PORT=3306

# ── CORS — origens autorizadas a chamar a API ────────────────────────────────
# Frontend na Vercel + domínio próprio
CORS_ALLOWED_ORIGINS=https://atrpap.com.br,https://www.atrpap.com.br,https://atrpap.vercel.app

# ── Frontend (Vite / Vercel) ──────────────────────────────────────────────────
# Esta variável é lida pelo React em build time. Configure também no painel da Vercel.
VITE_API_URL=https://atrpap.com.br/api

# ── URL do site (usada no painel Django admin — botão "Ver Site") ─────────────
SITE_URL=https://atrpap.com.br
